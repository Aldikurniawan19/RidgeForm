---
import BrandMark from './BrandMark.astro';
import Icons from './Icons.astro';

interface Props {
  variant?: 'transparent' | 'solid';
}

const { variant = 'transparent' } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Services', href: '/portfolio' },
  { label: 'Works', href: '/#section_works' },
  { label: 'Contact', href: '/contact' },
];
---
<header class:list={['rf-header', { 'rf-header-solid': variant === 'solid' }]}>
  <div class="rf-container">
    <div class="rf-nav-row">
      <a href="/" aria-label="RidgeForm home">
        <BrandMark variant="light" />
      </a>

      <nav class="rf-nav-links" aria-label="Primary navigation">
        {navItems.map((item) => {
          const active = pathname === item.href;
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={['rf-nav-pill', { 'is-active': active }]}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <div class="rf-nav-actions">
        <a href="/contact" class="rf-btn rf-btn-secondary rf-nav-desktop-cta">
          <span>Get a Quote</span>
          <Icons name="arrow-right" size={16} />
        </a>
        <button
          type="button"
          class="rf-menu-btn"
          data-nav-open
          aria-label="Open navigation menu"
          aria-expanded="false"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="4" y1="7" x2="20" y2="7" />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="17" x2="20" y2="17" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<div class="rf-drawer" data-nav-drawer role="dialog" aria-modal="true" aria-label="Mobile menu">
  <div class="rf-drawer-backdrop" data-nav-close></div>
  <div class="rf-drawer-panel">
    <div class="rf-drawer-top">
      <a href="/" aria-label="RidgeForm home">
        <BrandMark variant="light" />
      </a>
      <button type="button" class="rf-drawer-close" data-nav-close aria-label="Close navigation menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="6" y1="6" x2="18" y2="18" />
          <line x1="18" y1="6" x2="6" y2="18" />
        </svg>
      </button>
    </div>
    <nav class="rf-drawer-links" aria-label="Mobile navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={['rf-drawer-link', { 'is-active': pathname === item.href }]}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <a href="/contact" class="rf-btn rf-btn-primary" style="width: 100%; margin-top: auto;">
      <span>Get a Quote</span>
      <Icons name="arrow-right" size={16} />
    </a>
  </div>
</div>
