---
import Icons from './Icons.astro';
import { testimonials } from '../data/company';
---
<section class="rf-section rf-section-stone">
  <div class="rf-container">
    <div class="rf-section-header">
      <div class="rf-section-header-main">
        <div data-reveal class="rf-kicker">
          <span class="rf-kicker-dot"></span>
          <span>CLIENT STORIES</span>
        </div>
        <h2 data-split-reveal class="rf-h2">
          Trusted Feedback From Protected Properties
        </h2>
      </div>
      <div data-reveal data-delay="160" class="rf-section-header-aside">
        <p class="rf-lead">
          Real results from homeowners, facilities directors, and commercial property landlords.
        </p>
      </div>
    </div>

    <div data-reveal data-delay="220" class="rf-carousel" data-carousel>
      <div class="rf-carousel-viewport">
        <div class="rf-carousel-track" data-carousel-track>
          {testimonials.map((item) => (
            <div class="rf-carousel-slide" data-carousel-slide>
              <article class="rf-testimonial-card">
                <div class="rf-testimonial-img-wrap">
                  <img src={item.image} alt={item.name} loading="lazy" />
                </div>
                <div class="rf-testimonial-body">
                  <blockquote style="margin: 0;" class="rf-testimonial-quote">
                    {item.quote}
                  </blockquote>
                  <div class="rf-testimonial-foot">
                    <div>
                      <p class="rf-h5">{item.name}</p>
                      <p class="rf-small" style="margin-top: 0.25rem;">{item.role}</p>
                    </div>
                    <div style="text-align: right;">
                      <p class="rf-small">Rating</p>
                      <div class="rf-grade-stars">
                        <span>{item.grade}</span>
                        <span class="rf-stars">
                          {Array.from({ length: 5 }).map(() => (
                            <Icons name="star" size={14} />
                          ))}
                        </span>
                      </div>
                    </div>
                  </div>
                </div>
              </article>
            </div>
          ))}
        </div>
      </div>

      <div class="rf-carousel-controls">
        <button type="button" class="rf-circle-nav" data-carousel-prev aria-label="Previous testimonial">
          <Icons name="arrow-left" size={18} />
        </button>
        <button type="button" class="rf-circle-nav" data-carousel-next aria-label="Next testimonial">
          <Icons name="arrow-right" size={18} />
        </button>
      </div>
    </div>
  </div>
</section>
